# Copy this file to .env.local and fill in the real values.
# Never commit .env.local. Only NEXT_PUBLIC_ values are visible in the browser.

# Supabase → Project Settings → Data API (URL) and API Keys (publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase → Project Settings → API Keys → Secret keys. Server only, never share it.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Google Cloud Console → Google Auth Platform → Clients (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts Google tokens in the database. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the same value forever, or saved Google connections stop working.
TOKEN_ENCRYPTION_KEY=
